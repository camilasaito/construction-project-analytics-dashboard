      <aliases enabled='yes' />
      <column caption='Donut' datatype='integer' name='[Calculation_6306420631961601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='RFI Late' datatype='integer' name='[Calculation_6306420635373570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;Open&quot;&#10;AND [due_date] &lt; TODAY()&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='RFI Days Late' datatype='integer' name='[Calculation_6306420636561411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;Open&quot;&#10;AND [due_date] &lt; TODAY()&#10;THEN DATEDIFF(&apos;day&apos;, [due_date], TODAY())&#10;END' />
      </column>
      <column caption='RFI Days to Close' datatype='integer' name='[Calculation_6306420637724676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;Closed&quot;&#10;AND NOT ISNULL([closed_date])&#10;THEN DATEDIFF(&apos;day&apos;, [created_date], [closed_date])&#10;END' />
      </column>
      <column caption='Submittal Late' datatype='integer' name='[Calculation_6306420647440389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (submittals.csv)] = &quot;Open&quot;&#10;AND [due_date (submittals.csv)] &lt; TODAY()&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Submittal Days Late' datatype='integer' name='[Calculation_6306420647739398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (submittals.csv)] = &quot;Open&quot;&#10;AND [due_date (submittals.csv)] &lt; TODAY()&#10;THEN DATEDIFF(&apos;day&apos;, [due_date (submittals.csv)], TODAY())&#10;END' />
      </column>
      <column caption='Submittal Days to Close' datatype='integer' name='[Calculation_6306420648136711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (submittals.csv)] = &quot;Closed&quot;&#10;AND NOT ISNULL([closed_date (submittals.csv)])&#10;THEN DATEDIFF(&apos;day&apos;, [created_date (submittals.csv)], [closed_date (submittals.csv)])&#10;END' />
      </column>
      <column caption='Observation Late' datatype='integer' name='[Calculation_6306420651720712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (observations.csv)] = &quot;Open&quot;&#10;AND [due_date (observations.csv)] &lt; TODAY()&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Observation Days Late' datatype='integer' name='[Calculation_6306420651995145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (observations.csv)] = &quot;Open&quot;&#10;AND [due_date (observations.csv)] &lt; TODAY()&#10;THEN DATEDIFF(&#10;    &apos;day&apos;,&#10;    [due_date (observations.csv)],&#10;    TODAY()&#10;)&#10;END' />
      </column>
      <column caption='Observation Days to Close' datatype='integer' name='[Calculation_6306420652232714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (observations.csv)] = &quot;Closed&quot;&#10;AND NOT ISNULL([closed_date (observations.csv)])&#10;THEN DATEDIFF(&#10;    &apos;day&apos;,&#10;    [created_date (observations.csv)],&#10;    [closed_date (observations.csv)]&#10;)&#10;END' />
      </column>
      <column caption='Inspection - Days Since Last Inspection' datatype='integer' name='[Calculation_6306420655009804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;day&apos;,&#10;    MAX([inspection_date]),&#10;    TODAY()&#10;)' />
