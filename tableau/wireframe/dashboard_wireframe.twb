        <calculation class='tableau' formula='IF [status (deficiencies.csv)] = &quot;Open&quot;&#10;AND [due_date (deficiencies.csv)] &lt; TODAY()&#10;THEN DATEDIFF(&#10;    &apos;day&apos;,&#10;    [due_date (deficiencies.csv)],&#10;    TODAY()&#10;)&#10;END' />
      </column>
      <column caption='Deficiency Days to Close' datatype='integer' name='[Calculation_6306420659441680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status (deficiencies.csv)] = &quot;Closed&quot;&#10;AND NOT ISNULL([closed_date (deficiencies.csv)])&#10;THEN DATEDIFF(&#10;    &apos;day&apos;,&#10;    [created_date (deficiencies.csv)],&#10;    [closed_date (deficiencies.csv)]&#10;)&#10;END' />
      </column>
      <column caption='Recordable Incidents' datatype='integer' name='[Calculation_6306420660293649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([recordable_flag])' />
      </column>
      <column caption='Lost Time Injuries' datatype='integer' name='[Calculation_6306420660502546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lost_time_flag])' />
      </column>
      <column caption='Days Since Last LTI' datatype='integer' name='[Calculation_6306420660592659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;day&apos;,&#10;    MAX(&#10;        IF [lost_time_flag] = 1&#10;        THEN [incident_date]&#10;        END&#10;    ),&#10;    TODAY()&#10;)' />
      </column>
